/* Encrypted document library: type filters, thumbnails and secure preview */
.document-type-bar{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0 18px}.document-type-bar button{min-height:36px;padding:7px 12px;font-size:11px;border-radius:999px}.document-type-bar button[aria-pressed="true"]{color:#fff;background:#554be0;border-color:#554be0;box-shadow:0 5px 15px #554be026}
.doc-card{overflow:hidden}.doc-preview-trigger{display:block;width:100%;height:150px;padding:0;margin:0 0 12px;border:0;border-radius:13px;overflow:hidden;background:linear-gradient(145deg,#eeecff,#f7f6ff);position:relative}.doc-thumbnail{width:100%;height:100%;display:grid;place-items:center;position:relative}.doc-thumbnail img{width:100%;height:100%;object-fit:cover}.doc-file-icon{display:grid;place-items:center;width:62px;height:72px;border-radius:10px;background:#fff;box-shadow:0 8px 24px #39365119;color:#4f46d5;font-size:27px;font-weight:800}.doc-file-type{position:absolute;left:9px;bottom:8px;padding:3px 8px;border-radius:999px;background:#29263dcc;color:#fff;font-size:9px;font-weight:750;letter-spacing:.6px}.doc-kind-image .doc-preview-trigger{background:linear-gradient(145deg,#e6f5ef,#edf7ff)}.doc-kind-pdf .doc-file-icon{color:#b94d56;background:#fff0f1}.doc-kind-word .doc-file-icon{color:#2d67b1;background:#edf5ff}.doc-kind-excel .doc-file-icon{color:#287153;background:#e9f7ef}.doc-kind-text .doc-file-icon{color:#7c5b30;background:#fff7df}
#docPreviewDialog{width:min(1050px,calc(100vw - 24px));max-width:none;padding:0;overflow:hidden}#docPreviewDialog>.doc-preview-shell{padding:18px}#docPreviewTitle{margin:0;overflow-wrap:anywhere}.doc-preview-stage{min-height:320px;max-height:68vh;display:grid;place-items:center;margin:14px 0;border:1px solid #deddec;border-radius:15px;overflow:auto;background:#eeeff6}.doc-preview-stage img{display:block;max-width:100%;max-height:68vh;object-fit:contain}.doc-preview-stage iframe{width:100%;height:68vh;border:0;background:#fff}.doc-preview-stage pre{align-self:start;width:100%;margin:0;padding:20px;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.65 ui-monospace,SFMono-Regular,Menlo,monospace;color:#292b3b;background:#fff}.doc-preview-placeholder{text-align:center;padding:35px}.doc-preview-placeholder .doc-file-icon{margin:0 auto 18px;width:78px;height:92px;font-size:34px}.doc-preview-meta{display:flex;gap:8px 18px;flex-wrap:wrap;color:#74768b;font-size:11px}.doc-preview-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:14px}
.mode-compact-grid .doc-card:not(.is-expanded)>.doc-preview-trigger{display:block;height:92px;margin-bottom:8px}.mode-compact-grid .doc-card:not(.is-expanded)>.doc-preview-trigger .doc-file-icon{width:42px;height:50px;font-size:18px}.mode-compact-grid .doc-card:not(.is-expanded){min-height:190px}.mode-compact-list .doc-card:not(.is-expanded){grid-template-columns:54px minmax(120px,1fr) minmax(130px,1fr) minmax(160px,2fr);min-height:70px}.mode-compact-list .doc-card:not(.is-expanded)>.doc-preview-trigger{display:block;grid-column:1;grid-row:1;width:48px;height:48px;margin:0}.mode-compact-list .doc-card:not(.is-expanded)>.doc-preview-trigger .doc-file-icon{width:31px;height:37px;font-size:13px}.mode-compact-list .doc-card:not(.is-expanded)>.doc-preview-trigger .doc-file-type{display:none}.mode-compact-list .doc-card:not(.is-expanded)>.taxonomy-badges{grid-column:2}.mode-compact-list .doc-card:not(.is-expanded)>h3{grid-column:3}.mode-compact-list .doc-card:not(.is-expanded)>.compact-glance{grid-column:4}
@media(max-width:650px){.doc-preview-trigger{height:120px}.doc-preview-stage{min-height:240px}.doc-preview-stage iframe{height:62vh}.mode-compact-list .doc-card:not(.is-expanded){grid-template-columns:48px minmax(90px,1fr) minmax(100px,1.3fr)}.mode-compact-list .doc-card:not(.is-expanded)>.compact-glance{display:none}}
